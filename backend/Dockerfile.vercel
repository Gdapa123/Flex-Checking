# Environnement de TEST sur Vercel (fonction conteneurisée, sans processus permanent).
# Production : Dockerfile (cible prod) + docker-compose.prod.yml sur un serveur.
#
# Différences avec la production, toutes réglées par variables d'environnement :
#   - base Postgres (DATABASE_URL, Neon) au lieu de MySQL : mysqlclient n'est pas installé ;
#   - pas de worker Celery : les tâches (emails, actions groupées) s'exécutent dans la requête ;
#   - exports toujours générés dans la requête (pas de fichier à conserver entre deux requêtes) ;
#   - pas de Redis : sans cache ni temps réel, les écrans se mettent à jour toutes les 5 s.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PORT=8000 WEB_CONCURRENCY=2 DB_CONCURRENCE=8 \
    CELERY_TASK_ALWAYS_EAGER=1 EXPORT_SEUIL_ASYNCHRONE=1000000 REDIS_URL=
WORKDIR /app
COPY requirements.txt ./
RUN grep -v '^mysqlclient' requirements.txt > /tmp/requirements.txt \
    && pip install --no-cache-dir -r /tmp/requirements.txt \
    && useradd --system --uid 10001 --home /app flex
COPY --chown=flex . .
USER flex
EXPOSE 8000
CMD ["gunicorn", "config.asgi:application", "-c", "gunicorn.conf.py"]
