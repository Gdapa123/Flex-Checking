# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,flex-checking.localhost,django
# URL publique de l'application (liens des emails, QR d'inscription)
APP_PUBLIC_URL=https://flex-checking.localhost
CSRF_TRUSTED_ORIGINS=https://flex-checking.localhost,https://localhost,http://localhost:5173

# --- MySQL ---
MYSQL_DATABASE=flex_checking
MYSQL_USER=flex_checking
MYSQL_PASSWORD=flex_checking
MYSQL_ROOT_PASSWORD=root
DB_HOST=127.0.0.1
DB_PORT=3307

# --- Redis / Celery ---
REDIS_URL=redis://127.0.0.1:6380/0

# --- Emails ---
# console en développement, smtp en production
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=evenements@mde.ci

# --- JWT ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_HOURS=12

# --- Sécurité ---
# Nombre de proxys de confiance devant Django (Caddy = 1). Sert à identifier l'IP réelle pour les limites de débit.
NUM_PROXIES=1
